{
  "name": "js-ast-deobfuscator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bundled Babel AST deobfuscator runtime for the js-ast-deobfuscate Cursor skill",
  "scripts": {
    "deob": "node src/index.js",
    "test": "node scripts/run-fixtures.mjs",
    "test:c1": "node scripts/run-c1-tests.mjs",
    "test:c2": "node scripts/run-c2-tests.mjs",
    "test:c3": "node scripts/run-c3-tests.mjs",
    "test:c4": "node scripts/run-c4-tests.mjs",
    "test:c5": "node scripts/run-c5-tests.mjs",
    "test:c6": "node scripts/run-c6-tests.mjs",
    "test:c6-dead-branch": "node scripts/run-c6-dead-branch-tests.mjs",
    "test:c7": "node scripts/run-c7-tests.mjs",
    "test:c7-decrypt": "node scripts/run-c7-decrypt-tests.mjs",
    "test:c8": "node scripts/run-c8-tests.mjs",
    "test:c8-state": "node scripts/run-c8-state-tests.mjs",
    "test:c9": "node scripts/run-c9-tests.mjs",
    "test:c1-c6": "npm run test:c1 && npm run test:c2 && npm run test:c3 && npm run test:c4 && npm run test:c5 && npm run test:c6",
    "test:stage78": "npm run test:c7-decrypt && npm run test:c8-state && npm run test:c8",
    "test:a-promote": "node scripts/run-a-promote-tests.mjs",
    "test:phase1": "node scripts/run-phase1-tests.mjs",
    "test:extras": "npm run test:c6-dead-branch && npm run test:stage78 && npm run test:a-promote && npm run test:phase1"
  },
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0"
  }
}
